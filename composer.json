{
    "name": "artesoft/storefront",
    "type": "project",
    "require": {
        "php": "^8.3",
        "dompdf/dompdf": "^3.1",
        "laravel/framework": "13.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "@php artisan test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "mockery/mockery": "1.*",
        "nunomaduro/collision": "8.*",
        "phpunit/phpunit": "12.*"
    }
}
